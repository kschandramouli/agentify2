# Development environment variables for agentify backend

# Server
PORT=:8080
ENV=dev

# Database (Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=agentify

# Agent service
AGENT_SERVICE_URL=http://localhost:8001

# Vector store (Weaviate locally, SaaS or EKS in production)
VECTOR_STORE_TYPE=weaviate
VECTOR_STORE_ENDPOINT=localhost:8080
VECTOR_STORE_API_KEY=

# AWS
AWS_REGION=ap-southeast-2
CLOUDWATCH_LOG_GROUP=/agentify/backend

# Claude API (for agent service)
ANTHROPIC_API_KEY=your-key-here
# Optional: route model calls through an in-region proxy / gateway (ADR 0007).
# The Anthropic SDK honors this automatically.
# ANTHROPIC_BASE_URL=https://your-in-region-proxy.example.com

# Egress data governance (backend; ADR 0007 / context-mesh/policies/data-governance.md)
REDACTION_ENABLED=true          # allowlist-redact data sent toward the agent/model
REDACTION_PSEUDONYMIZE=false    # replace identifier values (pod/svc/secret names) with stable hashes

# Pod registry backend: "dynamodb" (default) or "memory" (local dev, no AWS)
REGISTRY_BACKEND=dynamodb
